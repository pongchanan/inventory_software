{
    "$schema": "https://railway.app/railway.schema.json",
    "services": {
        "backend": {
            "source": {
                "directory": "backend"
            },
            "config": {
                "startCommand": "python main.py",
                "healthcheck": "/health"
            }
        },
        "frontend": {
            "source": {
                "directory": "frontend"
            },
            "config": {
                "startCommand": "npm run start",
                "buildCommand": "npm run build"
            }
        }
    }
}