# Using SQLite for local development, PostgreSQL for production
DATABASE_URL=sqlite:///./inventory.db
PORT=3000
DEBUG=True

AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_DEFAULT_REGION=your_aws_default_region
AWS_ENDPOINT_URL=your_aws_endpoint_url
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
S3_BUCKET_NAME=your_s3_bucket_name

JWT_SECRET=your_jwt_secret

# MQTT Broker (TCP) – mosquitto-jwt
MOSQUITTO_TCP_HOST=your_mqtt_tcp_host
MOSQUITTO_TCP_PORT=your_mqtt_tcp_port
MOSQUITTO_USER=your_mqtt_username

# MQTT topic lists (comma-separated)
# Wildcard subscriptions are supported:
#   kiosk/#  subscribes to ALL topics under kiosk/ in one go
#   kiosk/+/scan  matches exactly one dynamic level (e.g. kiosk/001/scan)
#
# Current topics handled by mqtt_handlers.py:
#   kiosk/scan       – borrow/return scan events
#   kiosk/heartbeat  – liveness pings from kiosks
MQTT_SUBSCRIBE_TOPICS=YOUR_MQTT_SUBSCRIBE_TOPICS
# Topics the server is allowed to publish to
#   kiosk/response   – result of each scan sent back to the kiosk
MQTT_PUBLISH_TOPICS=YOUR_MQTT_PUBLISH_TOPICS

# WebSocket endpoint (optional – not used by the TCP background service)
MOSQUITTO_WS_HOST=your_mqtt_ws_host
MOSQUITTO_WS_PORT=your_mqtt_ws_port