{
    "name": "inventory-software-monorepo",
    "version": "1.0.0",
    "description": "Monorepo for Smart Inventory Management System",
    "scripts": {
        "dev": "dotenv -e .env -- concurrently -n \"BACKEND,FRONTEND\" -c \"blue,green\" \"npm run backend\" \"npm run frontend\"",
        "backend": "node scripts/dev/run-backend.cjs",
        "dev:backend": "node scripts/dev/run-backend.cjs",
        "frontend": "cd frontend && npm run dev",
        "dev:frontend": "cd frontend && npm run dev",
        "install-all": "node scripts/dev/install-all.cjs",
        "test:backend": "node scripts/dev/run-backend-tests.cjs",
        "test:backend:cov": "node scripts/dev/run-backend-tests.cjs --cov=app --cov-report=term-missing",
        "test:frontend": "cd frontend && npm test --",
        "build": "cd frontend && npm run build",
        "kiosk:config": "node scripts/dev/run-python-script.cjs scripts/generate_kiosk_config.py",
        "db:migrate": "node scripts/dev/run-python-script.cjs --cwd backend --venv backend/venv scripts/migration/drop_legacy_tables_now.py",
        "db:seed": "node scripts/dev/run-python-script.cjs --cwd backend --venv backend/venv scripts/admin/create_admin.py",
        "db:migrate:sqlite": "npm run db:migrate",
        "db:seed:sqlite": "npm run db:seed",
        "db:setup:sqlite": "npm run db:migrate:sqlite && npm run db:seed:sqlite"
    },
    "devDependencies": {
        "concurrently": "^8.2.2"
    },
    "dependencies": {
        "dotenv-cli": "^11.0.0"
    }
}